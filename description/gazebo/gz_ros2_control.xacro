<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="gz_ros2_control" params="prefix">
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find unconstrained_mpc_controller_demo)/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>
  </xacro:macro>
</robot>
